apiVersion: v1
kind: Service
metadata:
  name: {{ .Values.meta.name }}-patroni-replica-service
  labels:
    application: {{ .Values.meta.name }}-patroni
    cluster-name: {{ .Values.meta.name }}-patroni
    role: replica
spec:
  type: ClusterIP
  selector:
    application: {{ .Values.meta.name }}-patroni
    cluster-name: {{ .Values.meta.name }}-patroni
    role: replica
  ports:
    - port: 5432
      targetPort: 5432
